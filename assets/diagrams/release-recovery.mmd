flowchart TD
    A["Feature branch and evidence"] --> B{"Required approval and evidence valid?"}
    B -->|No| C["Hold this feature; other teams continue"]
    B -->|Yes| D["Integrate serially against latest main"]
    D --> E{"Combined checks pass?"}
    E -->|No| F["Repair affected work; renew approval if material"]
    F --> D
    E -->|Yes| G["Update main and deploy through authorized process"]
    G --> H{"Production checks pass?"}
    H -->|No| I["Use safe recovery; record unresolved work"]
    H -->|Yes| J["Record deployment and task outcomes"]
    J --> K["Stop previews; remove eligible worktrees and temporary files"]
    K --> L["Verify cleanup; record retained resources and failures"]
